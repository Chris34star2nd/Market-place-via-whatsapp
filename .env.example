# SokoHub Environment Variables
# Copy this file to .env and fill in your values

# Supabase (pre-populated in Bolt — do not change unless using your own project)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Super Admin credentials
# The email that gets full Super Admin access
VITE_SUPER_ADMIN_EMAIL=admin@sokohub.co.ke
# The password is NOT stored in frontend env — it lives only in Supabase Auth.
# The admin signs in at /admin with email + password, validated server-side by Supabase.

# Auth mode
# Set to "true" to allow unauthenticated emails — a person signs in with Google,
# their email is accepted without verification, and they are immediately logged in.
# Set to "false" to require verified Google accounts only.
VITE_ALLOW_UNVERIFIED_EMAILS=true

# Frontend URL (for CORS, redirects)
VITE_FRONTEND_URL=http://localhost:5173

# === Server-side only (NEVER expose to browser) ===

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database (server-side)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session
SESSION_SECRET=your_random_session_secret

# Email (for order notifications to sellers and admin email composer)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
